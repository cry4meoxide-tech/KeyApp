<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10">

    <LinearLayout
        android:id="@+id/screenKey"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ВХОД"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/inputKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ключ доступа"
            android:textColor="#FFFFFF"
            android:textColorHint="#666677"
            android:background="#1A1A24"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ВОЙТИ"
            android:textColor="#0B0B10"
            android:backgroundTint="#FFD54F"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screenPromo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#0B0B10"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="АКЦИЯ НА ВСЕГДА"
            android:textColor="#FFD54F"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="888 ₽"
            android:textColor="#FFD54F"
            android:textSize="64sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="вместо 8900 ₽"
            android:textColor="#666677"
            android:textSize="18sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:15:00"
            android:textColor="#FF5252"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnBuy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="КУПИТЬ СЕЙЧАС"
            android:textColor="#0B0B10"
            android:textStyle="bold"
            android:backgroundTint="#FFD54F"/>
    </LinearLayout>
</FrameLayout>